# ==========================================
# FRONTEND CONFIGURATION
# ==========================================

# URL gốc của Backend API (Bắt buộc bắt đầu bằng VITE_ để React/Vite có thể đọc được)
VITE_API_URL=http://localhost:5000/api/v1

# URL của Socket.io Server (Thường trùng với URL backend, không có /api/v1)
VITE_SOCKET_URL=http://localhost:5000

# Tên ứng dụng (Sử dụng trong thẻ title hoặc header)
VITE_APP_NAME="CueZone Billiards System"
