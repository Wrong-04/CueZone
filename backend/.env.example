# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# DATABASE (MongoDB)
# ==========================================
# Local: mongodb://localhost:27017/cuezone_db
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cuezone_db
MONGO_URI=mongodb://localhost:27017/cuezone_db

# ==========================================
# AUTHENTICATION (JWT)
# ==========================================
# Khóa bí mật để ký JWT (Thay đổi bằng một chuỗi ngẫu nhiên, vd: dùng 'openssl rand -hex 64')
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# UPLOAD (Cloudinary) - UC04
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# EMAIL (Nodemailer) - UC03
# ==========================================
# Sử dụng Gmail App Password hoặc SMTP của nhà cung cấp khác
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="CueZone Billiards" <no-reply@cuezone.com>
