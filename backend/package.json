{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "node seed.js",
    "db:migrate": "pnpm build && node scripts/migrate-erd.cjs",
    "db:migrate:fields": "pnpm build && node scripts/migrate-erd-fields.cjs",
    "db:migrate:booking-status": "node scripts/migrate-booking-status-validator.cjs",
