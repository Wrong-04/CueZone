    "check:booking-deposit-pos": "pnpm build && node scripts/check-booking-deposit-pos.cjs",
    "check:pos": "pnpm build && node scripts/check-pos.cjs",
    "check:vouchers": "pnpm build && node scripts/check-vouchers.cjs",
    "check:customer-orders": "pnpm build && node scripts/check-customer-orders.cjs",
    "check:tournament-reg": "pnpm build && node scripts/check-tournament-registration.cjs",
    "check:news": "pnpm build && node scripts/check-news.cjs",
    "check:claim-account": "pnpm build && node scripts/check-claim-counter-account.cjs",
    "check:tournament-checkin": "pnpm build && node scripts/check-tournament-checkin.cjs",
    "check:bracket": "pnpm build && node scripts/check-bracket.cjs"
